[GNOME Session]
Name=Pizlix GNOME
# gnome-session resolves each entry by desktop-file id: this must match
# /etc/xdg/autostart/org.gnome.Shell.desktop (a RequiredComponents value of
# "gnome-shell" would make gnome-session look for a gnome-shell.desktop that
# does not exist and refuse to start the session).  Sprint 5 supersedes
# Sprint 4's standalone mutter: gnome-shell is the same mutter-14 compositor
# with the shell UI on top, started by gnome-session as the DisplayServer
# phase's required component.
RequiredComponents=org.gnome.Shell;
