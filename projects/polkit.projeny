diff --git a/polkit/src/symbol.map b/polkit/src/symbol.map
--- a/polkit/src/symbol.map
+++ b/polkit/src/symbol.map
@@ -1,6 +1,11 @@
 {
 global:
   polkit_*;
+  /* Fil-C pizlonation exports pizlonated_<name> aliases for every exported
+   * function, and out-of-library consumers (pkexec, polkitagenttextlistener,
+   * the tests, the g-ir-scanner dumper) reference those aliases directly;
+   * they must not be caught by "local: *". */
+  pizlonated*;
 local:
   *;
 };
