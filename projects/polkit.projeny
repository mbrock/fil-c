URL: http://archive.ubuntu.com/ubuntu/pool/main/p/policykit-1/policykit-1_126.orig.tar.gz 822b19a17845611876d3624a0cbe9c6231d23e7316d86e383c5694faa544b19f
URL: http://deb.debian.org/debian/pool/main/p/policykit-1/policykit-1_126.orig.tar.gz 822b19a17845611876d3624a0cbe9c6231d23e7316d86e383c5694faa544b19f
Origname: polkit-126
Name: polkit

    polkit 126 (PolicyKit authorization manager). Ubuntu/Debian orig tarball (identical bytes in both pools; upstream's own release pages 404 and the GitHub release carries no tarball assets). Uses its bundled duktape JS engine, so no mozjs dependency.
diff --git a/polkit/meson.build b/polkit/meson.build
--- a/polkit/meson.build
+++ b/polkit/meson.build
@@ -206,6 +206,12 @@
   config_data.set10('HAVE_' + func.to_upper(), cc.has_function(func, dependencies: logind_dep))
 endif
 config_data.set('HAVE_LIBSYSTEMD', enable_logind)
+# pizlix/Fil-C: elogind provides the same sd_* API through <elogind/sd-*.h>;
+# upstream's guards conflate "session tracking via sd-login" with "built
+# against systemd", which breaks the elogind build (no systemd headers).
+if session_tracking == 'elogind'
+  config_data.set('HAVE_LIBELOGIND', true)
+endif

 config_data.set('HAVE_PIDFD_OPEN', cc.get_define('SYS_pidfd_open', prefix: '#include <sys/syscall.h>') != '')

diff --git a/polkit/src/polkit/polkitenumtypes.c.template b/polkit/src/polkit/polkitenumtypes.c.template
--- a/polkit/src/polkit/polkitenumtypes.c.template
+++ b/polkit/src/polkit/polkitenumtypes.c.template
@@ -11,9 +11,13 @@
 GType
 @enum_name@_get_type (void)
 {
-  static volatile gsize g_define_type_id__volatile = 0;
+  /* Fil-C: the location must have pointer type and the value must be stored
+   * with the _pointer variants of g_once_init_enter/leave, so that the GType
+   * keeps its pointer representation (the plain variants round-trip the
+   * value through gsize). */
+  static gpointer g_define_type_id__volatile = 0;

-  if (g_once_init_enter ((gsize*) &g_define_type_id__volatile))
+  if (g_once_init_enter_pointer (&g_define_type_id__volatile))
     {
       static const G@Type@Value values[] = {
 /*** END value-header ***/
@@ -27,7 +31,8 @@
       };
       GType g_define_type_id =
         g_@type@_register_static (g_intern_static_string ("@EnumName@"), values);
-      g_once_init_leave (&g_define_type_id__volatile, g_define_type_id);
+      /* Fil-C: see above. */
+      g_once_init_leave_pointer (&g_define_type_id__volatile, g_define_type_id);
     }

   return g_define_type_id__volatile;
