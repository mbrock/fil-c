URL: https://ftp.gnome.org/pub/GNOME/sources/libgweather/4.4/libgweather-4.4.4.tar.xz e71ce50ddfd2856be95e5d840258063e0080de8d7bbd9abe368cb1a8e4b1912a
Origname: libgweather-4.4.4
Name: libgweather

    libgweather 4.4.4 (weather/timezone/locations database; gnome-shell's date menu and weather widget link libgweather-4). Requires geocode-glib.
diff --git a/libgweather/libgweather/gweather-enum-types.c.tmpl b/libgweather/libgweather/gweather-enum-types.c.tmpl
--- a/libgweather/libgweather/gweather-enum-types.c.tmpl
+++ b/libgweather/libgweather/gweather-enum-types.c.tmpl
@@ -16,9 +16,13 @@
 GType
 @enum_name@_get_type (void)
 {
-    static gsize g_define_enum_type;
+    /* pizlix/Fil-C: the location must have pointer type and the value must be
+     * stored with the _pointer variants of g_once_init_enter/leave, so the
+     * GType keeps its pointer representation (the plain variants round-trip
+     * the value through gsize). */
+    static gpointer g_define_enum_type;

-    if (g_once_init_enter (&g_define_enum_type)) {
+    if (g_once_init_enter_pointer (&g_define_enum_type)) {
         static const G@Type@Value values[] = {
 /*** END value-header ***/

@@ -32,7 +36,7 @@

         GType enum_type = g_@type@_register_static (g_intern_static_string ("@EnumName@"), values);

-        g_once_init_leave (&g_define_enum_type, enum_type);
+        g_once_init_leave_pointer (&g_define_enum_type, enum_type);
     }

     return g_define_enum_type;
