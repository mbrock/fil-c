URL: https://download.gnome.org/sources/geocode-glib/3.26/geocode-glib-3.26.4.tar.xz 0ee660bf041521268c93372ace91684aea9cad0935872c53a9215ba5066e5330
URL: https://ftp.gnome.org/pub/GNOME/sources/geocode-glib/3.26/geocode-glib-3.26.4.tar.xz 0ee660bf041521268c93372ace91684aea9cad0935872c53a9215ba5066e5330
Origname: geocode-glib-3.26.4
Name: geocode-glib

    geocode-glib 3.26.4 (geocoding helper library; libgweather-4 depends on it). Last 3.26 release - the 3.26 series is what libgweather 4.4 uses.
diff --git a/geocode-glib/geocode-glib/geocode-glib.map b/geocode-glib/geocode-glib/geocode-glib.map
--- a/geocode-glib/geocode-glib/geocode-glib.map
+++ b/geocode-glib/geocode-glib/geocode-glib.map
@@ -2,6 +2,10 @@
   global:
     geocode_*;
     _geocode_parse_search_json;
+    /* Fil-C pizlonation exports pizlonated_<name> aliases for every exported
+     * function; consumers (libgweather, the g-ir-scanner dumper) reference
+     * those aliases directly; they must not be caught by "local: *". */
+    pizlonated*;

   local:
     *;
