-	if (g_once_init_enter (&krc_file_group_type_id__once)) {
+	/* pizlix/Fil-C: pointer-typed static + _pointer variants so the GType
+	 * keeps its pointer representation. */
+	static gpointer krc_file_group_type_id__once = 0;
+	if (g_once_init_enter_pointer (&krc_file_group_type_id__once)) {
 		GType krc_file_group_type_id;
 		krc_file_group_type_id = krc_file_group_get_type_once ();
-		g_once_init_leave (&krc_file_group_type_id__once, krc_file_group_type_id);
+		g_once_init_leave_pointer (&krc_file_group_type_id__once, krc_file_group_type_id);
 	}
-	return krc_file_group_type_id__once;
+	return (GType) (guintptr) krc_file_group_type_id__once;
 }

