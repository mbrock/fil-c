URL: https://github.com/ibus/ibus/releases/download/1.5.30/ibus-1.5.30.tar.gz 0cc837cc2a3d764b35d7168add94c284d47cde22f7cb9c7e57c1262d5c510d68
Origname: ibus-1.5.30
Name: ibus

    ibus 1.5.30 (Intelligent Input Bus; gnome-shell 46 talks to ibus-daemon via D-Bus and links libibus). GitHub release tarball; the freedesktop.org ibus release pages no longer carry 1.5.x tarballs.
diff --git a/ibus/configure b/ibus/configure
--- a/ibus/configure
+++ b/ibus/configure
@@ -12428,7 +12428,7 @@
 symcode='[BCDEGRST]'

 # Regexp to match symbols that can be accessed directly from C.
-sympat='\([_A-Za-z][_A-Za-z0-9]*\)'
+sympat='\(pizlonated_[_A-Za-z][_A-Za-z0-9]*\)'

 # Define system-specific variables.
 case $host_os in
@@ -12494,14 +12494,14 @@
 # so use this general approach.
 lt_cv_sys_global_symbol_to_cdecl="$SED -n"\
 $lt_cdecl_hook\
-" -e 's/^T .* \(.*\)$/extern int \1();/p'"\
-" -e 's/^$symcode$symcode* .* \(.*\)$/extern char \1;/p'"
+" -e 's/^T .* pizlonated_\(.*\)$/extern int \1();/p'"\
+" -e 's/^$symcode$symcode* .* pizlonated_\(.*\)$/extern char \1;/p'"

 # Transform an extracted symbol line into symbol name and symbol address
 lt_cv_sys_global_symbol_to_c_name_address="$SED -n"\
 $lt_c_name_hook\
 " -e 's/^: \(.*\) .*$/  {\"\1\", (void *) 0},/p'"\
-" -e 's/^$symcode$symcode* .* \(.*\)$/  {\"\1\", (void *) \&\1},/p'"
+" -e 's/^$symcode$symcode* .* pizlonated_\(.*\)$/  {\"\1\", (void *) \&\1},/p'"

 # Transform an extracted symbol line into symbol name with lib prefix and
 # symbol address.
@@ -12509,7 +12509,7 @@
 $lt_c_name_lib_hook\
 " -e 's/^: \(.*\) .*$/  {\"\1\", (void *) 0},/p'"\
 " -e 's/^$symcode$symcode* .* \(lib.*\)$/  {\"\1\", (void *) \&\1},/p'"\
-" -e 's/^$symcode$symcode* .* \(.*\)$/  {\"lib\1\", (void *) \&\1},/p'"
+" -e 's/^$symcode$symcode* .* pizlonated_\(.*\)$/  {\"lib\1\", (void *) \&\1},/p'"

 # Handle CRLF in mingw tool chain
 opt_cr=
@@ -12588,8 +12588,8 @@
       fi

       # Make sure that we snagged all the symbols we need.
-      if $GREP ' nm_test_var$' "$nlist" >/dev/null; then
-	if $GREP ' nm_test_func$' "$nlist" >/dev/null; then
+      if $GREP ' pizlonated_nm_test_var$' "$nlist" >/dev/null; then
+	if $GREP ' pizlonated_nm_test_func$' "$nlist" >/dev/null; then
 	  cat <<_LT_EOF > conftest.$ac_ext
 /* Keep this code in sync between libtool.m4, ltmain, lt_system.h, and tests.  */
 #if defined _WIN32 || defined __CYGWIN__ || defined _WIN32_WCE
@@ -12622,7 +12622,7 @@
 {
   { "@PROGRAM@", (void *) 0 },
 _LT_EOF
-	  $SED "s/^$symcode$symcode* .* \(.*\)$/  {\"\1\", (void *) \&\1},/" < "$nlist" | $GREP -v main >> conftest.$ac_ext
+	  $SED "s/^$symcode$symcode* .* pizlonated_\(.*\)$/  {\"\1\", (void *) \&\1},/" < "$nlist" | $GREP -v main >> conftest.$ac_ext
 	  cat <<\_LT_EOF >> conftest.$ac_ext
   {0, (void *) 0}
 };
diff --git a/ibus/portal/ibus-portal-dbus.c b/ibus/portal/ibus-portal-dbus.c
--- a/ibus/portal/ibus-portal-dbus.c
+++ b/ibus/portal/ibus-portal-dbus.c
@@ -153,27 +153,27 @@
 {
   gboolean ret = FALSE;
   g_assert (G_VALUE_TYPE (a) == G_VALUE_TYPE (b));
-  switch (G_VALUE_TYPE (a))
+  switch ((uintptr_t) G_VALUE_TYPE (a))
     {
-      case G_TYPE_BOOLEAN:
+      case (uintptr_t) G_TYPE_BOOLEAN:
         ret = (g_value_get_boolean (a) == g_value_get_boolean (b));
         break;
-      case G_TYPE_UCHAR:
+      case (uintptr_t) G_TYPE_UCHAR:
         ret = (g_value_get_uchar (a) == g_value_get_uchar (b));
         break;
-      case G_TYPE_INT:
+      case (uintptr_t) G_TYPE_INT:
         ret = (g_value_get_int (a) == g_value_get_int (b));
         break;
-      case G_TYPE_UINT:
+      case (uintptr_t) G_TYPE_UINT:
         ret = (g_value_get_uint (a) == g_value_get_uint (b));
         break;
-      case G_TYPE_INT64:
+      case (uintptr_t) G_TYPE_INT64:
         ret = (g_value_get_int64 (a) == g_value_get_int64 (b));
         break;
-      case G_TYPE_UINT64:
+      case (uintptr_t) G_TYPE_UINT64:
         ret = (g_value_get_uint64 (a) == g_value_get_uint64 (b));
         break;
-      case G_TYPE_DOUBLE:
+      case (uintptr_t) G_TYPE_DOUBLE:
         {
           /* Avoid -Wfloat-equal warnings by doing a direct bit compare */
           gdouble da = g_value_get_double (a);
@@ -181,10 +181,10 @@
           ret = memcmp (&da, &db, sizeof (gdouble)) == 0;
         }
         break;
-      case G_TYPE_STRING:
+      case (uintptr_t) G_TYPE_STRING:
         ret = (g_strcmp0 (g_value_get_string (a), g_value_get_string (b)) == 0);
         break;
-      case G_TYPE_VARIANT:
+      case (uintptr_t) G_TYPE_VARIANT:
         ret = _g_variant_equal0 (g_value_get_variant (a), g_value_get_variant (b));
         break;
       default:
diff --git a/ibus/src/ibusconfig.c b/ibus/src/ibusconfig.c
--- a/ibus/src/ibusconfig.c
+++ b/ibus/src/ibusconfig.c
@@ -102,7 +102,9 @@
             3,
             G_TYPE_STRING,
             G_TYPE_STRING,
-            G_TYPE_VARIANT | G_SIGNAL_TYPE_STATIC_SCOPE);
+            /* pizlix/Fil-C: GType is a pointer type, so the flag OR goes
+             * through uintptr_t, matching how the pizlonated glib does it. */
+            (GType) ((uintptr_t) G_TYPE_VARIANT | (uintptr_t) G_SIGNAL_TYPE_STATIC_SCOPE));
 }

 static void
diff --git a/ibus/tools/krcfile.c b/ibus/tools/krcfile.c
--- a/ibus/tools/krcfile.c
+++ b/ibus/tools/krcfile.c
@@ -283,13 +283,15 @@
 GType
 krc_file_key_value_pair_get_type (void)
 {
-	static volatile gsize krc_file_key_value_pair_type_id__once = 0;
-	if (g_once_init_enter (&krc_file_key_value_pair_type_id__once)) {
+	/* pizlix/Fil-C: pointer-typed static + _pointer variants so the GType
+	 * keeps its pointer representation. */
+	static gpointer krc_file_key_value_pair_type_id__once = 0;
+	if (g_once_init_enter_pointer (&krc_file_key_value_pair_type_id__once)) {
 		GType krc_file_key_value_pair_type_id;
 		krc_file_key_value_pair_type_id = krc_file_key_value_pair_get_type_once ();
-		g_once_init_leave (&krc_file_key_value_pair_type_id__once, krc_file_key_value_pair_type_id);
+		g_once_init_leave_pointer (&krc_file_key_value_pair_type_id__once, krc_file_key_value_pair_type_id);
 	}
-	return krc_file_key_value_pair_type_id__once;
+	return (GType) (guintptr) krc_file_key_value_pair_type_id__once;
 }

 void
@@ -340,13 +342,15 @@
 GType
